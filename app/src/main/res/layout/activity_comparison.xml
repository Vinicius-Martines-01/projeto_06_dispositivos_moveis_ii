<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comparisonMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ComparisonActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comparativo Etanol x Gasolina"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preço da Gasolina (R$)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editGasolinePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 5.89"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preço do Etanol (R$)"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editEthanolPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 3.99"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificar Vantagem"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/layoutComparisonResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="#EEEEEE"
            tools:visibility="visible">

            <TextView
                android:id="@+id/txtRecommendationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mais vantajoso: Etanol"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtComparisonRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relação: 70%"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtComparisonExplanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O etanol compensa quando custar até 70% do valor da gasolina."
                android:textSize="13sp"
                android:textColor="#555555" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
